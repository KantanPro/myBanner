{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "my-banner/banner",
	"title": "myBanner",
	"category": "widgets",
	"icon": "format-image",
	"description": "myBanner メニューで登録したバナー広告を表示します。複数登録時はローテーションします。",
	"keywords": [ "banner", "advertisement", "広告" ],
	"textdomain": "my-banner",
	"attributes": {
		"align": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"customClassName": true
	}
}
